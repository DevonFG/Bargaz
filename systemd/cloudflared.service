[Unit]
Description=Cloudflare Tunnel client
After=network-online.target
Wants=network-online.target

[Service]
TimeoutStartSec=15
Type=notify
ExecStart=/usr/bin/node /home/devon/Bargaz/backup-databases.js %i /home/devon/BargazBot/databases /home/devon/BargazBot/logs
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
